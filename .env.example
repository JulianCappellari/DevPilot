# Ejemplo sin secretos. Copiar a .env (fuera del control de versiones).
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATA_DIR=data
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
ENABLE_PAID_APIS=false
MAX_ACTIVE_RUNS=1
RUN_TIMEOUT_MINUTES=30
WORKSPACE_ROOT=data/worktrees
PROJECT_ROOTS=
LOG_REDACTION=true
SANDBOX=docker
SANDBOX_CPUS=2
SANDBOX_MEMORY_MIB=2048
SANDBOX_PIDS=256
SANDBOX_WORKSPACE_MIB=512
CODEX_MODE=off
COOKIE_SECURE=false
# Ejemplo para Tailscale Serve: https://equipo.tailnet.ts.net
ALLOWED_ORIGINS=
EMBEDDED_WORKER=true
BACKUP_INTERVAL_HOURS=24
ENABLE_GITHUB_PR=false
ENABLE_GITHUB_READ=false
