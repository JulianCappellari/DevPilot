# Ejemplo sin secretos. Copiar a .env (fuera del control de versiones).
NODE_ENV=development
DATABASE_URL=postgresql://devpilot:<LOCAL_PASSWORD>@127.0.0.1:5432/devpilot
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
ENABLE_PAID_APIS=false
MAX_ACTIVE_RUNS=1
RUN_TIMEOUT_MINUTES=30
WORKSPACE_ROOT=D:/DevPilot/worktrees
PROJECT_ROOTS=D:/Proyectos
LOG_REDACTION=true
