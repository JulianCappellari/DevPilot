{
  "name": "devpilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma personal local-first para orquestación y supervisión de agentes de programación.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test:run",
    "start": "tsx --env-file-if-exists=.env apps/api/src/main.ts",
    "dev": "tsx watch --env-file-if-exists=.env apps/api/src/main.ts",
    "setup": "tsx --env-file-if-exists=.env apps/api/src/cli.ts setup",
    "reset-password": "tsx --env-file-if-exists=.env apps/api/src/cli.ts reset-password",
    "demo": "tsx --env-file-if-exists=.env apps/api/src/cli.ts demo",
    "backup": "tsx --env-file-if-exists=.env apps/api/src/cli.ts backup",
    "backup:config": "tsx --env-file-if-exists=.env apps/api/src/cli.ts backup-config",
    "restore": "tsx --env-file-if-exists=.env apps/api/src/cli.ts restore",
    "worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "test:browser": "playwright test",
    "test:operations": "tsx apps/api/test/operations.ts",
    "bench:models": "tsx --env-file-if-exists=.env apps/api/src/bench-models.ts",
    "vendor:ui": "node scripts/vendor-ui.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "motion": "^14.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
